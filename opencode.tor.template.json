{
  "$schema": "https://opencode.ai/config.json",
  "websearch": false,
  "instructions": [
    "{{DIR}}/INSTRUCTIONS.md"
  ],
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "browser",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "policies": [
    {
      "action": "tool.use",
      "resource": "shell:*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "webfetch:*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "websearch:*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "browser:*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "tor-web": {
        "type": "local",
        "command": [
          "node",
          "{{DIR}}/server.mjs"
        ],
        "timeout": {
          "startup": 30000,
          "execution": 240000
        }
      }
    }
  }
}
